# Нормализация переводов строк
* text=auto eol=lf

# Бинарные артефакты — без преобразований
*.bmp binary
*.png binary
*.img binary
*.gz  binary

# Скрипты и документация — строго LF
*.md  text eol=lf
*.cjs text eol=lf
*.js  text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf