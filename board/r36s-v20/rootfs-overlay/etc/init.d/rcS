#!/bin/sh
# DEEPoS early userspace bring-up (busybox init ::sysinit hook).
#
# Deliberately tiny: every process started here costs RAM that the emulator
# will want later. This script must never abort the boot - a missing card
# partition or a re-run must leave the system usable: errexit is not enabled and every
# mount is best-effort.

is_mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }

mount_part() {
    partition="$1/$2"; dev="/dev/$2"; dir="$3"; opts="${4:-noatime}"
    if [ ! -r "$partition/partition" ]; then
        echo "DEEPoS: $dev missing for $dir" >&2
        return 1
    fi
    if is_mounted "$dir"; then
        grep -q "^$dev $dir " /proc/mounts 2>/dev/null && return 0
        echo "DEEPoS: $dir already mounted from another device" >&2
        return 1
    fi
    mount -o "$opts" "$dev" "$dir" 2>/dev/null && return 0
    echo "DEEPoS: cannot mount $dev on $dir" >&2
    return 1
}

mount_boot_card() {
    boot_slot=; flash_mounted=no; data_mounted=no; roms_mounted=no
    root_dev=$(awk '$5 == "/" && / - squashfs / { print $3; exit }' "$1" 2>/dev/null)
    root_part=
    [ -n "$root_dev" ] && root_part=$(readlink -f "$2/$root_dev" 2>/dev/null)
    card_path=${root_part%/*}
    card=${card_path##*/}
    if [ -r "$root_part/partition" ] && [ -n "$card" ]; then
        case "${root_part##*/}" in
            "$card"p2) boot_slot=A ;;
            "$card"p3) boot_slot=B ;;
        esac
    fi
    case "$card" in mmcblk[0-9]*) ;; *) boot_slot= ;; esac
    if [ -z "$boot_slot" ]; then
        echo "DEEPoS: cannot identify the MMC card for the squashfs root" >&2
        return 0
    fi
    # FAT has no journal: switching the console off mid-write leaves the volume
    # dirty and every later mount on a PC asks for fsck. /flash is written rarely
    # (boot report), so mounting it sync costs nothing and keeps it clean.
    mount_part "$card_path" "${card}p1" /flash sync && flash_mounted=yes
    mount_part "$card_path" "${card}p4" /data noatime && data_mounted=yes
    mount_part "$card_path" "${card}p5" /storage noatime && roms_mounted=yes
}

mount_game_card() {
    best=; best_score=0; best_size=0
    for reader in /sys/block/mmcblk[0-9]; do
        disk=${reader##*/}
        [ "$disk" != "$card" ] && [ -n "$card" ] || continue
        [ "$(cat "$reader/device/type" 2>/dev/null)" = SD ] || continue
        for partition in "$reader"/"${disk}"p[0-9]* "$reader"; do
            device="/dev/${partition##*/}"
            [ -b "$device" ] || continue
            info=$(blkid "$device" 2>/dev/null)
            case "$info" in
                *'LABEL="BOOT"'*|*'LABEL="ARCHR"'*|*'LABEL="DATA"'*) continue ;;
            esac
            case "$info" in
                *'TYPE="exfat"'*) fs=exfat; score=3 ;;
                *'TYPE="vfat"'*) fs=vfat; score=2 ;;
                *'TYPE="ext4"'*) fs=ext4; score=1 ;;
                *) continue ;;
            esac
            case "$info" in *'LABEL="ROMS"'*|*'LABEL="EASYROMS"'*|*'LABEL="GAMES"'*) score=4 ;; esac
            sectors=$(cat "$partition/size" 2>/dev/null)
            case "$sectors" in ''|*[!0-9]*) continue ;; esac
            if [ "$score" -gt "$best_score" ] ||
                { [ "$score" -eq "$best_score" ] && [ "$sectors" -gt "$best_size" ]; }; then
                best=$device; best_fs=$fs; best_score=$score; best_size=$sectors
            fi
        done
    done
    [ -n "$best" ] || return 0
    options=ro,nosuid,nodev,noexec
    [ "$best_fs" != ext4 ] || options=$options,noload
    if is_mounted /games || mount -t "$best_fs" -o "$options" "$best" /games; then
        printf '%s\n' "$best" > /run/deepos-tf2-device
    fi
}

# 1. Kernel filesystems. All best-effort: init may run on a re-exec or with
#    devtmpfs already mounted by the kernel.
mount -t proc     proc     /proc                 2>/dev/null || true
mount -t sysfs    sysfs    /sys                  2>/dev/null || true
mount -t devtmpfs devtmpfs /dev                  2>/dev/null || true
# The kernel inherits its hostname from the bootloader and keeps it, so /etc/hostname
# alone never reaches uname -n or the USB gadget description.
hostname deepos 2>/dev/null || true
mkdir -p /dev/pts /dev/shm
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
# Draw before probing storage or starting services. The launcher owns the next frame.
if [ -x /usr/bin/launcher ]; then
    /usr/bin/launcher --boot-splash >/dev/null 2>&1 || true
fi
mount -t devpts   devpts   /dev/pts              2>/dev/null || true
mount -t tmpfs    shm      /dev/shm -o mode=1777,nosuid,nodev 2>/dev/null || true
mount -t tmpfs    tmpfs    /tmp     -o mode=1777,nosuid,nodev 2>/dev/null || true
is_mounted /run || mount -t tmpfs tmpfs /run     -o mode=0755,nosuid,nodev 2>/dev/null ||
    echo "DEEPoS: cannot mount /run" >&2

# 2. Device nodes for early accesses (devtmpfs covers most, mdev -s the rest).
joypad="/lib/modules/$(uname -r)/archr-singleadc-joypad.ko"
if [ -r "$joypad" ] && ! insmod "$joypad"; then
    echo "DEEPoS: cannot load the Arch-R V20 joypad driver" >&2
fi
[ -x /sbin/mdev ] && mdev -s 2>/dev/null || true
if is_mounted /run; then
    /usr/local/bin/register-v20-joypad.sh || echo "DEEPoS: cannot register the V20 gamepad" >&2
fi

# 2a. Mali-G31 (panfrost) is modular in this kernel: nothing else creates the
#     render node, so every OpenGL application (RetroArch gl, PortMaster ports)
#     fails with "EGL not initialized" until the module set is loaded.
#     Order matters: panfrost depends on drm_shmem_helper and gpu-sched.
gpu_modules="drm_shmem_helper gpu-sched panfrost"
gpu_dir="/lib/modules/$(uname -r)"
for module in $gpu_modules; do
    [ -r "$gpu_dir/$module.ko" ] || continue
    insmod "$gpu_dir/$module.ko" 2>/dev/null ||
        echo "DEEPoS: cannot load $module" >&2
done
# The render node appears asynchronously after the DRM probe; wait briefly so
# the first launch after boot does not race it.
waited=0
while [ ! -e /dev/dri/renderD128 ] && [ "$waited" -lt 10 ]; do
    sleep 0.1 2>/dev/null || sleep 1
    waited=$((waited + 1))
done
# A launch pins the GPU governor to performance and restores it on exit. If the
# board lost power mid-game the pin can survive on /sys until the next reboot, so
# start from the power-saving governor every time.
[ -x /usr/local/bin/perf-boost.sh ] && /usr/local/bin/perf-boost.sh off

# 3. Partitions. Layout (see board/r36s-v20/layout.json):
#      p1 BOOT (FAT32)  -> /flash   boot chain, KERNEL, dtbs, extlinux
#      p2 SYS_A, p3 SYS_B (squashfs roots) - never mounted at runtime
#      p4 DATA (ext4)   -> /data    settings, save states, A/B state
#      p5 ROMS (exFAT)  -> /storage ROM library shared with the PC
#    Missing partitions (broken card, no card) are not fatal: the launcher
#    still starts and shows an empty library.
mount_boot_card /proc/self/mountinfo /sys/dev/block
if [ "$roms_mounted" = yes ] && is_mounted /run; then
    printf '/dev/%sp5\n' "$card" > /run/deepos-roms-device
fi
if is_mounted /run && [ -d /games ]; then
    mount_game_card
fi

# 3a. Development escape hatch. A card that carries /flash/DEBUG.ON gets the USB
#     network shell before the launcher starts, so a broken UI or a bad overlay
#     can still be diagnosed and reverted over USB, without a card reader.
#     Without the flag nothing listens on the network at all.
if [ -f /flash/DEBUG.ON ] && [ -x /usr/local/bin/usb-shell.sh ]; then
    if [ -x /usr/local/bin/usb-mode.sh ] &&
       [ "$(cat /run/deepos-usb.mode 2>/dev/null)" != network ]; then
        /usr/local/bin/usb-mode.sh network >/dev/null 2>&1 || true
    fi
    /bin/sh /usr/local/bin/usb-shell.sh >/dev/null 2>&1 &
    echo "DEEPoS: debug shell requested by DEBUG.ON" >&2
fi

# 4. Writable places the launcher expects even on a fresh card.
if [ "$data_mounted" = yes ]; then
    mkdir -p /data/config /data/saves 2>/dev/null || true
fi

# 4a. Memory. zram is a module set in this kernel (nothing is built in and
#     zswap is absent), while the ports expect a swap device and cannot create
#     one on the exFAT ROMS card. Load the zram stack, give it 512 MiB with lz4
#     (the cheapest codec for these four A35 cores) and keep a small file on
#     /data as cold overflow: the kernel drains the higher-priority zram first.
zram_modules="lz4_compress lz4hc_compress zstd_compress zsmalloc zram"
for module in $zram_modules; do
    [ -r "$gpu_dir/$module.ko" ] || continue
    insmod "$gpu_dir/$module.ko" 2>/dev/null ||
        echo "DEEPoS: cannot load $module" >&2
done
if [ -e /sys/block/zram0/disksize ]; then
    # The codec must be chosen before the size: once the device is initialised
    # the kernel refuses the change with EBUSY.
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    if echo 536870912 > /sys/block/zram0/disksize 2>/dev/null; then
        mkswap /dev/zram0 >/dev/null 2>&1 &&
            swapon -p 100 /dev/zram0 2>/dev/null ||
            echo "DEEPoS: cannot enable zram swap" >&2
    fi
fi
# The overflow file is small on purpose: DATA also carries the emulator bundle,
# so a wrong-sized swap file can fill the partition and break saves.
swap_file=/data/swapfile
swap_mib=128
if [ "$data_mounted" = yes ] && [ -w /data ]; then
    (
        free_mib=$(df -m /data 2>/dev/null | awk 'NR == 2 { print $4 }')
        if [ ! -s "$swap_file" ] && [ "${free_mib:-0}" -ge $((swap_mib + 256)) ]; then
            dd if=/dev/zero of="$swap_file" bs=1M count=$swap_mib 2>/dev/null &&
                chmod 600 "$swap_file" || rm -f "$swap_file"
            mkswap "$swap_file" >/dev/null 2>&1 || rm -f "$swap_file"
        fi
        if [ -s "$swap_file" ] && ! grep -q "^$swap_file " /proc/swaps; then
            swapon -p 10 "$swap_file" 2>/dev/null ||
                echo "DEEPoS: cannot enable the swap file" >&2
        fi
    ) >/dev/null 2>&1 &
fi

# 5. Record this boot before init starts the launcher. The ticket is valid only
#    for this boot and is consumed after the first hardware framebuffer blit.
if [ -x /usr/bin/updatr ] && [ "$data_mounted" = yes ] &&
   [ "$flash_mounted" = yes ] && is_mounted /run; then
    /usr/bin/updatr --state /data --boot /flash begin \
        --slot "$boot_slot" --boot-ticket /run/deepos-boot >/dev/null ||
        echo "DEEPoS: cannot record boot attempt" >&2
fi

# 7. Quiet kernel console: the splash screen owns the panel.
echo 0 > /proc/sys/kernel/printk 2>/dev/null || true

# 7a. First-boot provisioning: bundled modules and the demo port.
if [ "$data_mounted" = yes ] && [ ! -d /data/modules ]; then
    mkdir -p /data/modules 2>/dev/null || true
    cp -a /usr/share/deepos/modules/. /data/modules/ 2>/dev/null || true
fi
# Refresh only the unmodified 0.38 entry points, leaving user modules intact.
refresh_module_entry() {
    module_dir="/data/modules/$1"
    module_src="/usr/share/deepos/modules/$1"
    [ -d "$module_dir" ] || return 0
    installed=$(sha256sum "$module_dir/main.sh" 2>/dev/null) || return 0
    [ "${installed%% *}" = "$2" ] || return 0
    cp -p "$module_src/main.sh" "$module_dir/.main.new" &&
        mv -f "$module_dir/.main.new" "$module_dir/main.sh"
}
if [ "$data_mounted" = yes ]; then
    for module in battery storage emulators; do
        [ ! -e "/data/modules/$module" ] && [ ! -L "/data/modules/$module" ] || continue
        staged=$(mktemp -d /data/modules/.install.XXXXXX) || continue
        if cp -a "/usr/share/deepos/modules/$module/." "$staged/"; then
            mv -T "$staged" "/data/modules/$module" || rm -rf "$staged"
        else
            rm -rf "$staged"
        fi
    done
    refresh_module_entry thermal 5ce8d705136069f03cebbb17739e50022d23e8a1ff2a6bcf6171a415f9318cfd
    refresh_module_entry saves 59800fb67dd10a1f304d8b77bad021e4ce23e1e3406a5b6deba324491a76fbe0
    refresh_module_entry emulators 2f2aaf93b8309a1d3f369db494ed6792ce5ec6896cf5d8d490e6c0e9e136eb4c
    refresh_module_entry emulators 6606cc162599db3232d9101f60e18f5ec21d698dc2cd64f0b69361437d7ad21e
    old_registry=$(sha256sum /data/emulators.toml 2>/dev/null)
    if [ "${old_registry%% *}" = c6b5672c7ea2979579882ae2b02883860d8bfcc04e8f9e10607949f233e46ff5 ]; then
        cp /usr/share/deepos/emulators.toml /data/.emulators.new &&
            mv -f /data/.emulators.new /data/emulators.toml
    fi
fi
if [ "$roms_mounted" = yes ] && [ ! -d /storage/ports ]; then
    mkdir -p /storage/ports 2>/dev/null || true
    cp -a /usr/share/deepos/roms/. /storage/ 2>/dev/null || true
fi
if [ "$roms_mounted" = yes ] && [ -d /opt/deepos/portmaster/PortMaster ]; then
    mkdir -p /storage/ports
    [ -e /storage/ports/PortMaster.sh ] ||
        cp /usr/share/deepos/portmaster-entry.sh /storage/ports/PortMaster.sh
fi
if [ "$roms_mounted" = yes ] && [ ! -f /storage/.deepos-folders-v1 ] &&
   [ -r /usr/share/deepos/rom-folders.txt ]; then
    set --
    while IFS= read -r folder; do
        [ -z "$folder" ] || set -- "$@" "/storage/$folder"
    done < /usr/share/deepos/rom-folders.txt
    mkdir -p "$@" /storage/modules && touch /storage/.deepos-folders-v1
fi

# Start modd after provisioning so its socket is available on the first boot.
if [ "$data_mounted" = yes ] && is_mounted /run &&
   [ -x /usr/bin/modd ] && [ -d /data/modules ]; then
    /usr/bin/modd --modules /data/modules --data /data/module-data \
                  --socket /run/modd.sock &
fi

# 7a2. Apply the saved brightness / volume / cpu profile before the UI starts.
if [ -x /usr/bin/launcher ] && [ "$data_mounted" = yes ]; then
    /usr/bin/launcher --apply --data /data >/dev/null 2>&1 || true
fi

# 7b. Boot report on the BOOT partition (FAT32): the only channel that works
#     without UART or SSH - the card can be pulled and read from a PC.
if [ "$flash_mounted" = yes ]; then
    rep=/flash/report
    mkdir -p $rep 2>/dev/null || true
    if [ -d $rep ]; then
        {
            echo "DEEPoS boot report"
            date -u 2>/dev/null || true
            uname -a 2>/dev/null || true
            echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
            cat /proc/uptime 2>/dev/null | sed 's/^/uptime: /'
        } > $rep/boot.txt 2>/dev/null || true
        cat /proc/mounts > $rep/mounts.txt 2>/dev/null || true
        free -m > $rep/free.txt 2>/dev/null || true
        dmesg 2>/dev/null | tail -n 400 > $rep/dmesg.txt || true
        for z in /sys/class/thermal/thermal_zone*; do
            [ -r "$z/temp" ] || continue
            echo "$(cat $z/type 2>/dev/null): $(( $(cat $z/temp) / 1000 )) C"
        done > $rep/temps.txt 2>/dev/null || true
        {
            for f in scaling_cur_freq scaling_min_freq scaling_max_freq scaling_governor; do
                echo "$f: $(cat /sys/devices/system/cpu/cpufreq/policy0/$f 2>/dev/null)"
            done
            echo "gpu_cur: $(cat /sys/class/devfreq/ff400000.gpu/cur_freq 2>/dev/null)"
        } > $rep/cpufreq.txt 2>/dev/null || true
        ls /data/modules 2>/dev/null > $rep/modules.txt || true
        cat /run/deepos-tf2-device 2>/dev/null > "$rep/tf2.txt" || true
        dmesg 2>/dev/null | grep -iE "joypad|input:|evdev" > $rep/input-dmesg.txt || true
        ls -l /dev/input > $rep/input-devices.txt 2>/dev/null || true
        grep joypad /proc/modules > $rep/input-modules.txt 2>/dev/null || true
        if [ -x /usr/bin/launcher ]; then
            /usr/bin/launcher --selftest > $rep/selftest.txt 2>&1 || true
        fi
        if [ -x /usr/local/bin/bios-check.sh ]; then
            /usr/local/bin/bios-check.sh > $rep/bios.txt 2>/dev/null || true
        fi
        sync 2>/dev/null || true
    fi
fi

# 7c. Human verdict for the first boot: /flash/report/checks.txt (key=value).
if [ "$flash_mounted" = yes ] && [ -x /usr/local/bin/selfcheck.sh ]; then
    /usr/local/bin/selfcheck.sh /flash/report/checks.txt >/dev/null 2>&1 || true
    if is_mounted /run; then
        touch /run/deepos-boot-report 2>/dev/null || true
    fi
fi

# 8. Report readiness for the serial console. The UI itself is started by init
#    from /etc/inittab (::respawn) so a crashed launcher comes back by itself.
st=missing; [ "$roms_mounted" = yes ] && st=ok
dt=missing; [ "$data_mounted" = yes ] && dt=ok
echo "DEEPoS: storage=$st data=$dt"
exit 0
