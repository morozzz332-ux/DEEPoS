#!/bin/sh
# DEEPoS early userspace bring-up (busybox init ::sysinit hook).
#
# Deliberately tiny: every process started here costs RAM that the emulator
# will want later. This script must never abort the boot - a missing card
# partition or a re-run must leave the system usable: errexit is not enabled and every
# mount is best-effort.

# 1. Kernel filesystems. All best-effort: init may run on a re-exec or with
#    devtmpfs already mounted by the kernel.
mount -t proc     proc     /proc                 2>/dev/null || true
mount -t sysfs    sysfs    /sys                  2>/dev/null || true
mount -t devtmpfs devtmpfs /dev                  2>/dev/null || true
mkdir -p /dev/pts /dev/shm
mount -t devpts   devpts   /dev/pts              2>/dev/null || true
mount -t tmpfs    shm      /dev/shm -o mode=1777,nosuid,nodev 2>/dev/null || true
mount -t tmpfs    tmpfs    /tmp     -o mode=1777,nosuid,nodev 2>/dev/null || true

# 2. Device nodes for early accesses (devtmpfs covers most, mdev -s the rest).
[ -x /sbin/mdev ] && mdev -s 2>/dev/null || true

# 3. Partitions. Layout (see board/r36s-v20/layout.json):
#      p1 BOOT (FAT32)  -> /flash   boot chain, KERNEL, dtbs, extlinux
#      p2 SYS_A, p3 SYS_B (squashfs roots) - never mounted at runtime
#      p4 DATA (ext4)   -> /data    settings, save states, A/B state
#      p5 ROMS (exFAT)  -> /storage ROM library shared with the PC
#    Missing partitions (broken card, no card) are not fatal: the launcher
#    still starts and shows an empty library.
mkdir -p /flash /storage /data
is_mounted() { grep -q " $1 " /proc/mounts 2>/dev/null; }
mount_part() {
    dev="$1"; dir="$2"
    [ -b "$dev" ] || return 0
    is_mounted "$dir" && return 0
    mount -o noatime "$dev" "$dir" 2>/dev/null || true
}
mount_part /dev/mmcblk1p1 /flash
mount_part /dev/mmcblk1p4 /data
mount_part /dev/mmcblk1p5 /storage

# 4. Writable places the launcher expects even on a fresh card.
mkdir -p /data/config /data/saves 2>/dev/null || true

# 5. A/B boot accounting. Only when DATA really is mounted - otherwise the
#    counter would be lost on every boot and could roll the slot for nothing.
#    The bootloader reads extlinux.conf, so the chosen slot is written there.
if [ -x /usr/bin/updatr ] && is_mounted /data; then
    /usr/bin/updatr --state /data --boot /flash begin >/dev/null 2>&1 || true
    ( sleep 20; /usr/bin/updatr --state /data --boot /flash good >/dev/null 2>&1 ) &
fi

# 6. Module supervisor: only when at least one module is installed. Modules
#    live on DATA (the ROM volume is shared with the PC and stays clean).
if [ -x /usr/bin/modd ] && [ -d /data/modules ]; then
    mkdir -p /run 2>/dev/null || true
    /usr/bin/modd --modules /data/modules --data /data/module-data \
                  --socket /run/modd.sock &
fi

# 7. Quiet kernel console: the splash screen owns the panel.
echo 0 > /proc/sys/kernel/printk 2>/dev/null || true

# 7b. Boot report on the BOOT partition (FAT32): the only channel that works
#     without UART or SSH - the card can be pulled and read from a PC.
if is_mounted /flash; then
    rep=/flash/report
    mkdir -p $rep 2>/dev/null || true
    if [ -d $rep ]; then
        {
            echo "DEEPoS boot report"
            date -u 2>/dev/null || true
            uname -a 2>/dev/null || true
            echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
            cat /proc/uptime 2>/dev/null | sed 's/^/uptime: /'
        } > $rep/boot.txt 2>/dev/null || true
        cat /proc/mounts > $rep/mounts.txt 2>/dev/null || true
        free -m > $rep/free.txt 2>/dev/null || true
        dmesg 2>/dev/null | tail -n 400 > $rep/dmesg.txt || true
        for z in /sys/class/thermal/thermal_zone*; do
            [ -r "$z/temp" ] || continue
            echo "$(cat $z/type 2>/dev/null): $(( $(cat $z/temp) / 1000 )) C"
        done > $rep/temps.txt 2>/dev/null || true
        {
            for f in scaling_cur_freq scaling_min_freq scaling_max_freq scaling_governor; do
                echo "$f: $(cat /sys/devices/system/cpu/cpufreq/policy0/$f 2>/dev/null)"
            done
            echo "gpu_cur: $(cat /sys/class/devfreq/ff400000.gpu/cur_freq 2>/dev/null)"
        } > $rep/cpufreq.txt 2>/dev/null || true
        ls /data/modules 2>/dev/null > $rep/modules.txt || true
        if [ -x /usr/bin/launcher ]; then
            /usr/bin/launcher --selftest > $rep/selftest.txt 2>&1 || true
        fi
        sync 2>/dev/null || true
    fi
fi

# 8. Report readiness for the serial console. The UI itself is started by init
#    from /etc/inittab (::respawn) so a crashed launcher comes back by itself.
st=missing; is_mounted /storage && st=ok
dt=missing; is_mounted /data && dt=ok
echo "DEEPoS: storage=$st data=$dt"
exit 0
