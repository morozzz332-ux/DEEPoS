# DEEPoS - kernel configuration fragment for R36S-V20 (RK3326) MVP.
#
# Not a full defconfig: apply on top of `make rockchip_defconfig` (or
# `make defconfig` for arm64) with scripts/kconfig/merge_config.sh:
#
#   make ARCH=arm64 rockchip_defconfig
#   ARCH=arm64 scripts/kconfig/merge_config.sh .config board/r36s-v20/linux.config
#   make ARCH=arm64 olddefconfig
#
# `tests/board_test.py` verifies that every required symbol/expected value pair
# below is present, and that no forbidden (bloat) symbol is enabled.

# --- base -------------------------------------------------------------
CONFIG_SMP=y
CONFIG_ARM64=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y

# --- storage: SD card only, no eMMC -----------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=n
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=n
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=n
CONFIG_SQUASHFS_LZO=n
CONFIG_SQUASHFS_LZ4=n
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=n
CONFIG_OVERLAY_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- memory: zram/zswap, PSI and cgroups for the module supervisor ----
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=n
CONFIG_ZSWAP=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_KSM=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- display: ST7703 MIPI-DSI panel, PWM backlight, Panfrost ----------
CONFIG_DRM=y
# fbdev emulation gives the launcher a simple /dev/fb0 (RGB565)
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SITRONIX_ST7703=y
CONFIG_DRM_PANFROST=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_FB=n

# --- input: GPIO buttons, ADC sticks, ADC volume rocker ---------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=n
CONFIG_ROCKCHIP_SARADC=y

# --- audio: RK817 codec + simple-audio-card ---------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_ROCKCHIP_MAX98090=n

# --- power: RK817 PMIC, charger and fuel gauge ------------------------
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_CHARGER_RK817=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPUFREQ_DT=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# --- USB: dwc2 OTG in gadget mode (NCM/RNDIS/ACM/FFS) -----------------
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_DWC2_DUAL_ROLE=n
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_FS=y
CONFIG_USB_GADGETFS=n
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# --- console: debug UART on the test pads ----------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- keep the image lean ---------------------------------------------
CONFIG_MODULES=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_DRM_PANEL_EDP=n
CONFIG_IKCONFIG=n
CONFIG_DEBUG_KERNEL=n
