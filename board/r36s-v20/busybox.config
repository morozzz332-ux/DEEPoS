# DEEPoS - busybox configuration fragment (applets needed by init and modules).
#
# Apply on top of `make defconfig` inside busybox sources:
#   make defconfig && sed -i 's/^# CONFIG_.*//' ...  # see tools/build-busybox note
# then `make oldconfig`. The list is kept flat on purpose: `tests/board_test.py`
# only checks that each required applet is enabled and that shell/hush is set up
# as the init shell.
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_SWITCH_ROOT=y
CONFIG_PIVOT_ROOT=y
CONFIG_BLKID=y
CONFIG_FSTRIM=y
CONFIG_MKSWAP=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y
CONFIG_DMESG=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_CTTYHACK=y
CONFIG_SETCONSOLE=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_TOUCH=y
CONFIG_SLEEP=y
CONFIG_USLEEP=y
CONFIG_TEST=y
CONFIG_PRINTF=y
CONFIG_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_EXPR=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_WGET=y
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_UNZIP=y
CONFIG_ZCAT=y
CONFIG_SYNC=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_HALT=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_TOP=n
CONFIG_DF=y
CONFIG_DU=y
CONFIG_UNAME=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_IP=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_UDHCPC=y
CONFIG_UDHCPD=n
CONFIG_FEATURE_IPV6=n
CONFIG_FEATURE_WTMP=n
CONFIG_FEATURE_UTMP=n
CONFIG_CROND=n
CONFIG_SYSLOGD=n
